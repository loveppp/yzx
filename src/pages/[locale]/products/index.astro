---
import Layout from '@/layouts/Layout.astro';
import ProductCatalog from '@/components/ProductCatalog.astro';
import { locales, useTranslations, type Locale } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const path = `/${locale}/products/`;
const title = `${t.products.title} | ${t.siteNameFull}`;
---

<Layout title={title} description={t.products.subtitle} path={path}>
  <section class="border-b border-borui-navy/10 py-8 md:py-10">
    <div class="content-wrap">
      <h1 class="text-2xl text-borui-navy md:text-3xl">{t.products.title}</h1>
      <p class="mt-2 max-w-2xl text-sm text-borui-steel md:text-base">{t.products.subtitle}</p>
    </div>
  </section>

  <section class="section-padding pt-6 md:pt-8">
    <div class="content-wrap">
      <ProductCatalog locale={locale} />
      <p class="mt-6 text-xs text-borui-brass">{t.products.disclaimer}</p>
    </div>
  </section>
</Layout>
