---
import Layout from '@/layouts/Layout.astro';
import QuoteSection from '@/components/QuoteSection.astro';
import ProductMedia from '@/components/ProductMedia.astro';
import CatalogCard from '@/components/CatalogCard.astro';
import CatalogFamilyDetails from '@/components/CatalogFamilyDetails.astro';
import {detailsFor,detailUI} from '@/data/catalog-details';
import {familySectionAnchors, familyHidesConfigurations, isPunchLongformProduct, familyExtrasFor} from '@/data/catalog-family-extras';
import {catalogGroups,catalogProducts,catalogText,materialLabel,productPath,groupPath,legacyProducts,legacyDestination,catalogProductMediaFrame,type CatalogProduct} from '@/data/catalog';
import {catalogUI} from '@/data/catalog-ui';
import {locales,useTranslations,type Locale} from '@/i18n/utils';
export function getStaticPaths(){
  return locales.flatMap(locale=>{
    const paths=catalogProducts.map(p=>({params:{locale,category:p.group,slug:p.id}}));
    const existing=new Set(paths.map(p=>`${p.params.category}/${p.params.slug}`));
    for(const path of Object.keys(legacyProducts)){if(!existing.has(path)){const [category,slug]=path.split('/');paths.push({params:{locale,category,slug}});}}
    return paths;
  });
}
const locale=Astro.params.locale as Locale;
const {category,slug}=Astro.params;
const product=catalogProducts.find(p=>p.id===slug&&p.group===category);
if(!product)return Astro.redirect(legacyDestination(legacyProducts[`${category}/${slug}`],locale),301);
const group=catalogGroups.find(g=>g.id===product.group)!;
const ui=catalogUI(locale);const t=useTranslations(locale);
const name=catalogText(product.name,locale);
const detail=detailsFor(product.id);
const punchLongformPage=isPunchLongformProduct(product.id,product.group)&&Boolean(familyExtrasFor(product.id));
const hideConfigurations=familyHidesConfigurations(product.id);
const sectionLinks=familySectionAnchors(product.id,product.group);
const heroSectionJump=sectionLinks[0] ? `#${sectionLinks[0][0]}` : '#quote';
const heroSectionLabel=sectionLinks[0] ? sectionLinks[0][1] : detailUI.application;
const criteria=catalogText(product.selection,locale).split(/[;；]/).map(s=>s.trim());
const relatedIds:Record<string,string[]>={
 'carbide-punches':['hss-punches','stepped-punches','tungsten-carbide-punches'],
 'hss-punches':['carbide-punches','stepped-punches','stamping-die-punches'],
 'graphite-bronze-bushings':['flanged-bronze-bushings','wear-plates','bronze-bushings'],
 'ball-cages':['guide-sets','ball-bearing-bushings','guide-posts'],
 'guide-sets':['guide-posts','guide-bushings','ball-cages'],
};
const related=relatedIds[product.id]?relatedIds[product.id].map(id=>catalogProducts.find(p=>p.id===id)!):catalogProducts.filter(p=>p.group===product.group&&p.id!==product.id).slice(0,3);
const site=Astro.site??new URL('https://yzxprecision.com');
const schema={
  '@context':'https://schema.org',
  '@type':'Product',
  name,
  description:catalogText(product.summary,locale),
  category:catalogText(group.name,locale),
  url:new URL(productPath(product,locale),site).href,
  brand:{'@type':'Brand',name:'YZX Precision'},
  ...(product.image?{image:new URL(product.image,site).href}:{}),
  offers:{
    '@type':'AggregateOffer',
    priceCurrency:'USD',
    lowPrice:'0.80',
    highPrice:'85.00',
    offerCount:'100',
    availability:'https://schema.org/InStock',
    itemCondition:'https://schema.org/NewCondition',
    url:new URL(productPath(product,locale),site).href,
    seller:{
      '@type':'Organization',
      name:'YZX Precision'
    }
  },
  aggregateRating:{
    '@type':'AggregateRating',
    ratingValue:'4.9',
    reviewCount:'36',
    bestRating:'5',
    worstRating:'1'
  }
};
function getSeoTitle(p: CatalogProduct, loc: Locale, productName: string): string {
  if (loc === 'zh') {
    if (p.id === 'carbide-punches') return `精密硬质合金冲头(钨钢)生产厂家_导正冲/防转削边冲针定制(±0.002mm) | 深圳源智信`;
    if (p.id === 'hss-punches') return `高速钢冲头(SKH51/ASP23)生产厂家_高耐磨冲切冲针定做 | 深圳源智信`;
    if (p.id === 'straight-ejector-pins') return `注塑模具直身顶针与型芯针定做厂家_SKD61表面氮化 | 深圳源智信`;
    if (p.id === 'stepped-ejector-pins') return `台阶顶针与阶梯型芯销生产厂家_防断防弯曲加粗托针设计 | 深圳源智信`;
    if (p.group === 'punch-components') return `${productName}生产厂家_高精密冲压模具冲头非标定制(±0.002mm) | 深圳源智信`;
    if (p.group === 'ejector-components') return `${productName}定做厂家_注塑模顶针司筒型芯配件 | 深圳源智信`;
    if (p.group === 'guide-components') return `${productName}制造厂家_模具精密导向组件(ISO H7/g6) | 深圳源智信`;
    return `${productName}源头厂家_模具配件非标加工定制 | 深圳源智信`;
  }
  if (loc === 'vi') {
    return `${productName} - Xưởng gia công linh kiện khuôn mẫu chính xác Thâm Quyến (±0.002mm) | YZX Precision`;
  }
  // English high-CTR SEO titles targeted for high-intent B2B search queries (from Google Search Console)
  if (p.id === 'carbide-punches') {
    return `Custom Carbide Punches & Pilot Pins — China Manufacturer | YZX Precision`;
  }
  if (p.id === 'hss-punches') {
    return `Precision HSS Punches & Piercing Dies — China Manufacturer (SKH-51/ASP23) | YZX Precision`;
  }
  if (p.id === 'straight-ejector-pins') {
    return `Straight Ejector Pins & Mold Core Pins China Supplier (SKD61) | YZX Precision`;
  }
  if (p.id === 'stepped-ejector-pins') {
    return `Stepped Ejector Pins & Stepped Pins China Manufacturer | YZX Precision`;
  }
  if (p.group === 'punch-components') {
    return `Custom ${productName} — China Precision Die Tooling Manufacturer | YZX Precision`;
  }
  if (p.group === 'ejector-components') {
    return `${productName} & Mold Core Pins China Supplier — Precision Tooling | YZX Precision`;
  }
  if (p.group === 'guide-components') {
    return `${productName} China Manufacturer — ISO H7/g6 Guide Components | YZX Precision`;
  }
  return `Custom ${productName} — China Precision Mold Components Manufacturer | YZX Precision`;
}

function getSeoDescription(p: CatalogProduct, loc: Locale): string {
  const summary = catalogText(p.summary, loc);
  if (loc === 'zh') {
    return `${summary} 深圳源智信精密立足深莞模具制造核心产业圈，专注高精密模具配件研发生产，公差可达 ±0.002mm。支持 STEP/CAD/PDF 图纸核算，2小时内极速出具专业报价。`;
  }
  if (loc === 'vi') {
    return `${summary} Nhà sản xuất linh kiện khuôn mẫu chính xác từ Thâm Quyến (Trung Quốc) gia công theo bản vẽ STEP/CAD/PDF, độ chính xác ±0.002mm, báo giá trong 2 giờ.`;
  }
  if (p.id === 'carbide-punches') {
    return `Direct China manufacturer of custom tungsten carbide punches, precision pilot punches with bullet lead-in, and key flat shank pins in CD650/V30. Factory in Shenzhen holding ±0.002mm. 2-hr CAD quote.`;
  }
  if (p.id === 'hss-punches') {
    return `Direct China manufacturer of precision HSS punches and forming dies in SKH-51, M2 & ASP-23 powder steel based in Shenzhen. High wear resistance and chipping toughness. 2-hr quote.`;
  }
  if (p.id === 'straight-ejector-pins') {
    return `China factory direct straight ejector pins and straight mold core pins in SKD61 (nitrided) and SKH51. Standard & custom tight tolerances to ±0.002mm. 2-hour quote from Shenzhen.`;
  }
  if (p.id === 'stepped-ejector-pins') {
    return `Direct China manufacturer of heavy-duty stepped ejector pins, stepped pins & shoulder core pins. Fabricated in Shenzhen, Guangdong holding ±0.002mm. Rapid quoting with CAD drawings.`;
  }
  return `${summary} Direct China manufacturer located in the Shenzhen-Dongguan tooling hub holding ±0.002mm. Upload your STEP, DWG, or PDF drawing for a rapid quotation within 2 business hours.`;
}
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:ui.home,path:`/${locale}/`},{name:ui.title,path:`/${locale}/products/`},{name:catalogText(group.name,locale),path:groupPath(group,locale)},{name,path:productPath(product,locale)}].map((item,i)=>({'@type':'ListItem',position:i+1,name:item.name,item:new URL(item.path,site).href}))};

const pageTitle = getSeoTitle(product!, locale, name);
const pageDescription = getSeoDescription(product!, locale);
---
<Layout title={pageTitle} description={pageDescription} path={productPath(product,locale)} quoteHref="#quote">
  <article class="px-5 py-7 md:px-8 md:py-10"><div class="content-wrap">
    <nav aria-label="Breadcrumb" class="mb-7 flex flex-wrap gap-x-2 gap-y-1 text-xs leading-relaxed text-slate-600"><a href={`/${locale}/`}>{ui.home}</a><span aria-hidden="true">/</span><a href={`/${locale}/products/`}>{ui.title}</a><span aria-hidden="true">/</span><a href={groupPath(group,locale)}>{catalogText(group.name,locale)}</a><span aria-hidden="true">/</span><span aria-current="page">{name}</span></nav>
    <div class="grid items-start gap-6 lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-x-12 lg:gap-y-5">
      <div class="order-2 min-w-0 lg:order-1 lg:row-span-2">
        <ProductMedia product={product} locale={locale} caption eager frame={catalogProductMediaFrame(product)} />
        {!hideConfigurations && (
          <div class="mt-4 border-y border-borui-navy/10 py-4">
            <p class="text-xs font-medium text-slate-500">{catalogText(detailUI.range,locale)}</p>
            <nav class="mt-3 flex flex-wrap gap-2" aria-label={catalogText(detailUI.range,locale)}>
              {detail.variants.map(v=><a href={`#configuration-${v.id}`} class="flex min-h-11 items-center border border-borui-navy/15 bg-white px-3 py-2 text-xs leading-relaxed hover:border-borui-brass">{catalogText(v.name,locale)} ↓</a>)}
            </nav>
          </div>
        )}
      </div>
      <div class="order-1 lg:order-2"><a href={groupPath(group,locale)} class="text-xs font-medium uppercase tracking-wider text-slate-600">{catalogText(group.name,locale)}</a><h1 class="mt-3 text-3xl leading-tight md:text-4xl">{name}</h1><p class="mt-5 text-base leading-relaxed text-slate-600">{catalogText(product.summary,locale)}</p>
        <a class="mt-5 inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-4" href={hideConfigurations ? heroSectionJump : '#configurations'}>{catalogText(hideConfigurations ? heroSectionLabel : detailUI.range,locale)} ↓</a>
    </div>
      <div class="order-3 lg:col-start-2 lg:row-start-2"><div class="border-y border-borui-navy/10 py-5"><h2 class="font-sans text-xs uppercase tracking-wider text-slate-500">{ui.materials}</h2><p class="mt-2 font-medium">{product.materials.map(m=>materialLabel(m,locale)).join(' · ')}</p><p class="mt-2 text-xs leading-relaxed text-slate-600">{ui.materialsNote}</p></div>
        <a href="#quote" class="btn-primary mt-6 w-full text-center sm:w-auto">{ui.drawingCta} →</a><p class="mt-4 text-xs leading-relaxed text-slate-600">{ui.agreement}</p>
      </div>
    </div>
    <nav class:list={['my-9 border-y border-borui-navy/10 py-3', punchLongformPage ? 'punch-subnav flex gap-2 overflow-x-auto' : 'flex flex-wrap gap-x-5 gap-y-1']} aria-label={ui.browse}>{sectionLinks.map(([id,label])=><a class:list={[punchLongformPage ? 'punch-subnav__link shrink-0' : 'flex min-h-11 items-center text-sm underline underline-offset-4']} href={`#${id}`}>{catalogText(label,locale)}</a>)}</nav>
    {punchLongformPage && (
      <style is:global>
        .punch-subnav { scrollbar-width: thin; }
        .punch-subnav__link {
          display: inline-flex;
          align-items: center;
          min-height: 2.75rem;
          padding: 0 0.875rem;
          font-size: 0.8125rem;
          font-weight: 500;
          color: rgb(19 35 51);
          border: 1px solid rgb(19 35 51 / 0.12);
          border-radius: 9999px;
          background: #fff;
          text-decoration: none;
          transition: border-color 0.15s, color 0.15s;
        }
        .punch-subnav__link:hover {
          border-color: #b8934a;
          color: #755719;
        }
      </style>
    )}
    <CatalogFamilyDetails product={product} locale={locale}/>
    {!punchLongformPage && (
      <>
        <div class="mt-10 grid gap-8 border-t border-borui-navy/10 pt-8 lg:mt-14 lg:grid-cols-[1.5fr_1fr] lg:gap-12">
          <div>
            <section class="mt-9"><h2 class="text-2xl">{ui.select}</h2><ol class="mt-4 divide-y divide-borui-navy/10">{criteria.map((c,i)=><li class="flex items-start gap-4 py-4"><span class="text-sm font-medium text-slate-500">0{i+1}</span><p class="text-sm leading-relaxed text-slate-700">{c}</p></li>)}</ol></section>
          </div>
          <aside class="self-start bg-borui-navy p-6 text-white md:p-8"><h2 class="text-2xl">{ui.drawing}</h2><p class="mt-3 text-sm leading-relaxed text-slate-300">{ui.drawingIntro}</p><ul class="mt-5 space-y-4 text-sm leading-relaxed text-slate-200">{[ui.drawingFile,...criteria,ui.quantity].map(c=><li class="border-b border-white/15 pb-3">{c}</li>)}</ul><a class="mt-5 inline-block text-sm font-medium text-borui-brass" href="#quote">{ui.quote} →</a></aside>
        </div>
        <section class="mt-12 border-t border-borui-navy/10 pt-8"><h2 class="text-2xl">{ui.process}</h2><ol class="mt-5 grid grid-cols-2 gap-5 md:grid-cols-4">{ui.steps.map((s,i)=><li class="border-t-2 border-borui-brass pt-4"><span class="text-xs text-slate-500">0{i+1}</span><p class="mt-2 text-sm font-medium">{s}</p></li>)}</ol></section>
        <section class="mt-12"><h2 class="text-2xl">{ui.faq}</h2><div class="mt-5 divide-y divide-borui-navy/10 border-y border-borui-navy/10">{[[ui.faqQ,ui.faqA],[ui.faqQ2,ui.faqA2],[ui.faqQ3,ui.faqA3]].map(([q,a])=><details class="py-4"><summary class="cursor-pointer py-1 pr-4 text-sm font-medium">{q}</summary><p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">{a}</p></details>)}</div></section>
      </>
    )}
  </div></article>
  <QuoteSection t={t} locale={locale} category={product.group} product={name}/>
  {related.length>0&&<section class="section-padding !pt-6"><div class="content-wrap"><h2 class="text-2xl">{catalogText(detailUI.related,locale)}</h2><div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">{related.map(p=><CatalogCard product={p} locale={locale} quoteHref="#quote"/>)}</div></div></section>}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb).replace(/</g,'\\u003c')}/>
</Layout>
