---
// Clean instant client-side fallback redirect to /en/ (Cloudflare edge handles / -> /en/ via _redirects)
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content="0;url=/en/" />
  <link rel="canonical" href="https://yzxprecision.com/en/" />
  <title>YZX Precision</title>
  <script>location.replace('/en/');</script>
</head>
<body style="margin:0;background:#fff;"></body>
</html>
