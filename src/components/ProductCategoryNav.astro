---
import {
  moldApplicationOrder,
  taxonomyGroups,
  type MoldApplication,
} from '@/data/product-taxonomy';
import { localizedPath, type Dictionary, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
  t: Dictionary;
  currentPath?: string;
}

const { locale, t, currentPath = '' } = Astro.props;

const appLabels: Record<MoldApplication, string> = t.products.moldApplications;
---

<nav class="rounded border border-borui-navy/10 bg-white p-4" aria-label={t.products.browseByIndustry}>
  <p class="text-xs font-medium uppercase tracking-wider text-borui-steel">{t.products.browseByIndustry}</p>
  <ul class="mt-3 space-y-4">
    {
      moldApplicationOrder.map((app) => {
        const groups = taxonomyGroups.filter((g) => g.moldApplication === app);
        if (groups.length === 0) return null;
        return (
          <li>
            <p class="text-sm font-medium text-borui-navy">{appLabels[app]}</p>
            <ul class="mt-2 space-y-3 border-l border-borui-navy/10 pl-3">
              {groups.map((group) => (
                <li>
                  <p class="text-xs text-borui-brass">{t.products.taxonomyGroups[group.id]}</p>
                  <ul class="mt-1 space-y-1">
                    {group.categorySlugs.map((slug) => {
                      const href = localizedPath(`/products/${slug}/`, locale);
                      const active = currentPath.includes(`/products/${slug}`);
                      return (
                        <li>
                          <a
                            href={href}
                            class:list={[
                              'text-sm transition-colors hover:text-borui-brass',
                              active ? 'font-medium text-borui-navy' : 'text-borui-steel',
                            ]}
                          >
                            {t.products.categories[slug]}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ul>
  <a
    href={localizedPath('/custom-oem/', locale)}
    class="mt-4 block border-t border-borui-navy/10 pt-4 text-sm text-borui-brass hover:underline"
  >
    {t.nav.customOem} →
  </a>
</nav>
