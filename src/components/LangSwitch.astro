---
import { localeConfig } from '@/i18n/locales';
import { locales, switchLocalePath, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
---

<div class="relative">
  <label class="sr-only" for="lang-select">Language</label>
  <select
    id="lang-select"
    class="min-h-11 w-[7rem] sm:w-auto sm:max-w-[7.5rem] cursor-pointer border border-borui-navy/20 bg-transparent py-1 pl-2 pr-6 text-xs font-medium text-borui-navy focus:border-borui-brass focus:outline-none"
    onchange="window.location.href=this.value"
  >
    {
      locales.map((code) => (
        <option value={switchLocalePath(currentPath, code)} selected={code === locale}>
          {localeConfig[code].nativeName}
        </option>
      ))
    }
  </select>
</div>
