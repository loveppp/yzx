---
interface Props {
  quoteProduct: string;
  label: string;
}
const {quoteProduct, label} = Astro.props;
---

<a
  href="#quote"
  data-quote-product={quoteProduct}
  class="mt-5 inline-flex min-h-11 items-center text-sm font-medium text-borui-navy underline underline-offset-4 hover:text-borui-brass"
>
  {label} →
</a>
