---
import {punchCopy,punchProfiles,punchStructures,punchText} from '@/data/punch-specialist';
import type {Locale} from '@/i18n/locales';
interface Props {locale:Locale; quoteHref?:string;}
const {locale,quoteHref='#quote'}=Astro.props;
const tx=(v:Record<Locale,string>)=>punchText(v,locale);
---
<section id="working-profiles" class="scroll-mt-28 border-t border-borui-navy/10 py-10 md:py-14">
  <div class="max-w-3xl"><p class="text-xs tracking-[.16em] text-slate-500">01 / PROFILE</p><h2 class="mt-3 text-2xl md:text-3xl">{tx(punchCopy.profiles)}</h2><p class="mt-4 text-sm leading-relaxed text-slate-600">{tx(punchCopy.note)}</p><p class="mt-2 text-xs text-slate-500">{tx(punchCopy.shapeNote)}</p></div>
  <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {punchProfiles.map(p=><article id={`profile-${p.id}`} class="scroll-mt-28 border border-borui-navy/10 bg-white p-5 md:p-6">
      <div class="mb-5 flex h-24 items-center justify-between gap-4 border-b border-borui-navy/10 pb-4">
        <svg viewBox="0 0 140 80" class="h-20 w-32 text-borui-navy" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M10 40H130M70 5V75" stroke="#aab2bc" stroke-width="1" stroke-dasharray="4 4"/>
          {p.id==='round'&&<circle cx="70" cy="40" r="27" fill="#eef0f2"/>}
          {p.id==='square'&&<rect x="43" y="13" width="54" height="54" rx="2" fill="#eef0f2"/>}
          {p.id==='rectangular'&&<rect x="25" y="25" width="90" height="30" rx="2" fill="#eef0f2"/>}
          {p.id==='oblong'&&<rect x="25" y="19" width="90" height="42" rx="21" fill="#eef0f2"/>}
          {p.id==='hexagonal'&&<path d="M40 40L55 14H85L100 40L85 66H55Z" fill="#eef0f2"/>}
          {p.id==='custom'&&<path d="M35 63V25Q35 15 45 15H66V33H85Q108 33 108 48V63Z" fill="#eef0f2"/>}
        </svg><span class="text-xs uppercase tracking-widest text-slate-400">{p.id}</span>
      </div>
      <h3 class="text-lg">{tx(p.name)}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{tx(p.desc)}</p>
      <div class="mt-4 border-t border-borui-navy/10 pt-4"><p class="text-xs font-medium text-slate-500">{tx(punchCopy.specify)}</p><p class="mt-2 text-sm leading-relaxed">{tx(p.spec)}</p></div>
      <a href={quoteHref} class="mt-5 inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-4">{locale==='zh'?'发送图纸询价':locale==='vi'?'Gửi bản vẽ để báo giá':'Send drawing for quote'} →</a>
    </article>)}
  </div>
</section>
<section id="mounting-structures" class="scroll-mt-28 border-t border-borui-navy/10 py-10 md:py-14">
  <p class="text-xs tracking-[.16em] text-slate-500">02 / CONSTRUCTION</p><h2 class="mt-3 text-2xl md:text-3xl">{tx(punchCopy.structures)}</h2>
  <div class="mt-6 grid gap-x-10 sm:grid-cols-2">{punchStructures.map((p,i)=><article class="border-b border-borui-navy/10 py-6"><span class="text-xs text-borui-brass">0{i+1}</span><h3 class="mt-2 text-lg">{tx(p.name)}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{tx(p.desc)}</p></article>)}</div>
</section>
