---
import BrandedImage from './BrandedImage.astro';
import { getFactoryCaption, images } from '@/data/images';
import type { Dictionary, Locale } from '@/i18n/utils';

interface Props {
  t: Dictionary;
  locale: Locale;
}

const { t, locale } = Astro.props;
---

<section class="section-padding border-t border-borui-navy/10">
  <div class="content-wrap">
    <h2 class="text-2xl text-borui-navy md:text-3xl">{t.factory.title}</h2>
    <p class="mt-3 text-borui-steel">{t.factory.subtitle}</p>

    <div class="mt-8 flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory">
      {
        images.factory.map((item) => (
          <figure class="w-[min(85vw,420px)] shrink-0 snap-start">
            <div class="aspect-[4/3]">
              <BrandedImage
                src={item.src}
                alt={getFactoryCaption(item.captionKey, locale)}
                class="h-full"
                width={1200}
                height={900}
              />
            </div>
            <figcaption class="mt-2 text-sm text-borui-steel">
              {getFactoryCaption(item.captionKey, locale)}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
