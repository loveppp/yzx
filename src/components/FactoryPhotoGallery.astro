---
import BrandedImage from './BrandedImage.astro';
import { images } from '@/data/images';
import type { Dictionary } from '@/i18n/utils';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const caption = t.factory.realPhotoNote;
const alt = t.factory.realPhotoAlt;
---
<section class="section-padding border-t border-borui-navy/10 bg-borui-paper">
  <div class="content-wrap max-w-5xl">
    <header class="text-center">
      <h2 class="text-2xl text-borui-navy md:text-3xl">{t.factory.photosTitle}</h2>
      <p class="mt-2 text-sm text-slate-600">{caption}</p>
    </header>
    <ul class="mt-8 grid grid-cols-2 gap-3 md:gap-4">
      {
        images.factory.map((src) => (
          <li class="overflow-hidden border border-borui-navy/10 bg-white">
            <div class="aspect-[4/3] bg-borui-light">
              <BrandedImage
                src={src}
                alt={alt}
                class="h-full"
                width={1280}
                height={960}
                watermark={false}
                objectFit="cover"
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
