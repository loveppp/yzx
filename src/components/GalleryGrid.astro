---
import { images } from '@/data/images';

interface Props {
  title?: string;
  subtitle?: string;
  images?: readonly string[];
  altPrefix?: string;
}

const {
  title,
  subtitle,
  images: galleryImages = images.specialShaped,
  altPrefix = 'Special shaped punch',
} = Astro.props;
---

<section class="section-padding bg-borui-light">
  <div class="content-wrap">
    {title && <h2 class="text-2xl text-borui-navy md:text-3xl">{title}</h2>}
    {subtitle && <p class="mt-3 max-w-2xl text-borui-steel">{subtitle}</p>}

    <div class="mt-8 columns-2 gap-3 md:columns-3 lg:columns-4">
      {
        galleryImages.map((src, i) => (
          <div class="mb-3 break-inside-avoid overflow-hidden bg-white">
            <img
              src={src}
              alt={`${altPrefix} ${i + 1}`}
              class="w-full object-cover"
              loading="lazy"
              width="600"
              height="400"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
