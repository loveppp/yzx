---
import {catalogText, type CatalogProduct} from '@/data/catalog';
import {detailsFor, detailUI as ui} from '@/data/catalog-details';
import {familyExtrasFor, familyHidesConfigurations, isPunchLongformProduct} from '@/data/catalog-family-extras';
import {familyFiguresFor} from '@/data/catalog-family-figures';
import type {Locale} from '@/i18n/locales';
import detailMedia from '@/data/catalog-detail-media.json';
import { shouldShowDisplayWatermark } from '@/data/product-image';
import BrandedImage from './BrandedImage.astro';
import CatalogFamilyGenericLongform from './CatalogFamilyGenericLongform.astro';
import PunchFamilyLongform from './PunchFamilyLongform.astro';

interface Props {product: CatalogProduct; locale: Locale;}
const {product, locale} = Astro.props;
const detail = detailsFor(product.id);
const extras = familyExtrasFor(product.id);
const figs = familyFiguresFor(product.id);
const punchLongform = isPunchLongformProduct(product.id, product.group) && Boolean(extras);
const showConfigurations = !familyHidesConfigurations(product.id);
const familyImages = detailMedia.assets.filter((asset) => asset.productId === product.id);
const tx = (value: Parameters<typeof catalogText>[0]) => catalogText(value, locale);
---
{
  showConfigurations && (
    <section id="configurations" class:list={['scroll-mt-28 border-t border-borui-navy/10 pt-9', punchLongform && 'punch-config-section']} data-family-configurations={product.id}>
      <header class="flex flex-wrap items-end justify-between gap-3">
        <div>
          {punchLongform && <span class="punch-config-accent" aria-hidden="true" />}
          <h2 class="text-2xl md:text-3xl">{tx(ui.range)}</h2>
        </div>
        <span class="font-mono text-sm text-slate-500">{String(detail.variants.length).padStart(2, '0')}</span>
      </header>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600">{tx(ui.intro)}</p>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          detail.variants.map((variant) => {
            const quoteProduct = `${catalogText(product.name, locale)} · ${tx(variant.name)}`;
            return (
              <article id={`configuration-${variant.id}`} class="product-visual-card scroll-mt-28 flex flex-col border border-borui-navy/10 bg-white" data-configuration={variant.id}>
                {
                  familyImages
                    .filter((asset) => asset.configurationIds.includes(variant.id))
                    .map((asset) => (
                      <figure class="mb-0">
                        <div class="product-visual-frame aspect-square overflow-hidden bg-borui-light">
                          <BrandedImage
                            src={asset.image}
                            alt={tx(asset.name)}
                            width={800}
                            height={800}
                            loading="lazy"
                            class="h-full w-full"
                            objectFit="contain"
                            watermark={shouldShowDisplayWatermark(asset.image)}
                          />
                        </div>
                      </figure>
                    ))
                }
                <div class="flex flex-1 flex-col p-4 md:p-5">
                  <h3 class="text-base leading-snug md:text-lg">{tx(variant.name)}</h3>
                  <p class="mt-2 flex-1 text-base leading-relaxed text-slate-600">{tx(variant.description)}</p>
                  <a
                    href="#quote"
                    data-quote-product={quoteProduct}
                    class="configuration-inquiry-link mt-4 inline-flex min-h-11 items-center text-sm font-medium text-borui-navy underline underline-offset-4 hover:text-borui-brass"
                  >
                    {tx(ui.configurationInquiry)} →
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  )
}

<script is:inline>
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-quote-product]') : null;
    if (!target) return;
    const value = target.getAttribute('data-quote-product') || '';
    try {
      sessionStorage.setItem('yzx-quote-product', value);
    } catch {
      /* ignore */
    }
    window.dispatchEvent(new CustomEvent('yzx-quote-product-set', { detail: value }));
  });
</script>

{
  punchLongform && extras ? (
    <PunchFamilyLongform product={product} locale={locale} detail={detail} extras={extras} figs={figs} />
  ) : (
    <CatalogFamilyGenericLongform product={product} locale={locale} detail={detail} />
  )
}

{punchLongform && (
  <style is:global>
    .punch-config-accent {
      display: block;
      width: 2.25rem;
      height: 3px;
      margin-bottom: 0.75rem;
      background: #b8934a;
    }
  </style>
)}
