---
import {catalogText,materialLabel,type CatalogProduct} from '@/data/catalog';
import {detailsFor,detailUI as ui} from '@/data/catalog-details';
import {materialGuidanceFor,scenarioFor,questionFor,finishesFor,reasonFor} from '@/data/catalog-engineering';
import type {Locale} from '@/i18n/locales';
import detailMedia from '@/data/catalog-detail-media.json';
interface Props {product:CatalogProduct;locale:Locale;}
const {product,locale}=Astro.props;
const detail=detailsFor(product.id);
const familyImages=detailMedia.assets.filter(asset=>asset.productId===product.id);
const tx=(value:Parameters<typeof catalogText>[0])=>catalogText(value,locale);
const labels={zh:{materials:'可选材料及取舍',application:'典型场景',boundary:'选型重点',quote:'按此系列询价',faqQ:'询价时需要提供哪些尺寸与工况？'},en:{materials:'Available materials and trade-offs',application:'Typical scenario',boundary:'Selection considerations',quote:'Request this family',faqQ:'Which dimensions and operating details are needed for a quote?'},vi:{materials:'Vật liệu và cân nhắc',application:'Điều kiện điển hình',boundary:'Lưu ý lựa chọn',quote:'Yêu cầu dòng này',faqQ:'Cần kích thước và điều kiện nào để báo giá?'}}[locale];
---
<section id="configurations" class="scroll-mt-28 border-t border-borui-navy/10 pt-9" data-family-configurations={product.id}>
  <div class="flex flex-wrap items-end justify-between gap-3"><h2 class="text-2xl md:text-3xl">{tx(ui.range)}</h2><span class="font-mono text-sm text-slate-500">{String(detail.variants.length).padStart(2,'0')}</span></div>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">{tx(ui.intro)}</p>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">{detail.variants.map((variant,i)=><article id={`configuration-${variant.id}`} class="product-visual-card scroll-mt-28 flex flex-col border border-borui-navy/10 bg-white p-4 md:p-5" data-configuration={variant.id}>
    {familyImages.filter(asset=>asset.configurationIds.includes(variant.id)).map(asset=><figure class="-mx-4 -mt-4 mb-4 md:-mx-5 md:-mt-5"><div class="product-visual-frame aspect-square overflow-hidden bg-borui-light"><img src={asset.image} alt={tx(asset.name)} width="1200" height="1200" loading="lazy" class="h-full w-full object-contain"/></div><figcaption class="px-4 pt-2 text-xs text-slate-500 md:px-5">{tx(asset.name)}</figcaption></figure>)}
    <span aria-hidden="true" class="font-mono text-xs text-slate-400">{String(i+1).padStart(2,'0')}</span><h3 class="mt-2 text-base leading-snug md:text-lg">{tx(variant.name)}</h3><p class="mb-5 mt-3 text-sm leading-relaxed text-slate-600">{tx(variant.description)}</p><div class="mt-auto border-t border-borui-navy/10 pt-4"><p class="text-xs font-medium text-slate-500">{tx(ui.parameters)}</p><p class="mt-2 text-sm leading-relaxed">{tx(variant.parameters)}</p></div>
  </article>)}</div>
</section>
<section id="why-this-family" class="mt-10 scroll-mt-28 bg-borui-navy p-6 text-white md:p-9" data-family-section="why">
  <h2 class="text-2xl md:text-3xl">{tx(ui.choice)}</h2><div class="mt-5 grid gap-6 md:grid-cols-2"><p class="text-lg leading-relaxed text-slate-100">{tx(reasonFor(product.id))}</p><div class="border-l-2 border-borui-brass pl-5"><h3 class="text-sm font-medium text-borui-brass">{labels.boundary}</h3><p class="mt-3 text-sm leading-relaxed text-slate-200">{tx(detail.note)}</p></div></div>
</section>
<section id="material-options" class="mt-12 scroll-mt-28" data-family-section="materials">
  <h2 class="text-2xl md:text-3xl">{tx(ui.material)}</h2><h3 class="mt-6 text-sm font-medium text-slate-500">{labels.materials}</h3><div class="mt-3 grid gap-3 md:grid-cols-2">{product.materials.map(material=><article class="border-l-2 border-borui-brass bg-white p-5"><h4 class="font-sans text-base font-semibold">{materialLabel(material,locale)}</h4><p class="mt-3 text-sm leading-relaxed text-slate-600">{tx(materialGuidanceFor(product,material))}</p></article>)}</div>
</section>
<section id="surface-options" class="mt-9 scroll-mt-28" data-family-section="surface"><h2 class="text-2xl">{tx(ui.surface)}</h2><div class="mt-5 grid gap-5 md:grid-cols-2">{finishesFor(product).map(finish=><article class="border-t border-borui-navy/20 pt-4"><h3 class="font-sans text-base font-semibold">{tx(finish.name)}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{tx(finish.description)}</p></article>)}</div></section>
<section id="applications" class="mt-12 scroll-mt-28 border-y border-borui-navy/10 py-8" data-family-section="applications"><h2 class="text-2xl md:text-3xl">{tx(ui.application)}</h2><div class="mt-5 grid gap-5 md:grid-cols-[1fr_1.5fr]"><p class="text-sm leading-relaxed text-slate-600">{tx(product.application)}</p><div class="border-l-2 border-borui-brass pl-5"><h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">{labels.application}</h3><p class="mt-3 leading-relaxed">{tx(scenarioFor(product.id))}</p></div></div></section>
<section id="family-faq" class="mt-12 scroll-mt-28" data-family-section="faq"><h2 class="text-2xl md:text-3xl">{tx(ui.faq)}</h2><div class="mt-5 divide-y divide-borui-navy/10 border-y border-borui-navy/10">{[[tx(questionFor(product.id)),tx(detail.note)],[labels.faqQ,tx(product.selection)]].map(([q,a])=><details class="py-4"><summary class="cursor-pointer py-1 pr-4 text-sm font-medium leading-relaxed">{q}</summary><p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">{a}</p></details>)}</div></section>
