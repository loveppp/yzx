---
import {catalogText, productById, productPath} from '@/data/catalog';
import type {FamilyRelatedMaterial} from '@/data/catalog-family-extras';
import type {Locale} from '@/i18n/locales';
import ProductMedia from './ProductMedia.astro';

interface Props {
  locale: Locale;
  items: FamilyRelatedMaterial[];
  inquiryLabel: string;
}

const {locale, items, inquiryLabel} = Astro.props;
const tx = (value: Parameters<typeof catalogText>[0]) => catalogText(value, locale);
---

<div class="mt-6 grid gap-5 md:grid-cols-2">
  {
    items.map((item) => {
      const related = productById(item.productId);
      if (!related) return null;
      return (
        <article class="family-related-card">
          <a href={productPath(related, locale)} class="family-related-card__media">
            <ProductMedia product={related} locale={locale} />
          </a>
          <div class="family-related-card__body">
            <h3 class="text-lg font-medium leading-snug">
              <a href={productPath(related, locale)} class="hover:text-borui-brass">{catalogText(related.name, locale)} ↗</a>
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{tx(item.blurb)}</p>
            <a href="#quote" class="mt-4 inline-flex text-sm font-medium text-borui-navy underline underline-offset-4 hover:text-borui-brass">
              {inquiryLabel} →
            </a>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .family-related-card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(15 23 42 / 0.1);
    background: #fff;
  }
  @media (min-width: 768px) {
    .family-related-card {
      grid-template-columns: 5fr 7fr;
    }
  }
  .family-related-card__media {
    display: block;
    min-width: 0;
  }
  .family-related-card__body {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
  }
  @media (min-width: 768px) {
    .family-related-card__body {
      padding: 1.5rem;
    }
  }
</style>
