---
import {catalogText, materialLabel, productPath, type CatalogProduct} from '@/data/catalog';
import {detailsFor} from '@/data/catalog-details';
import {catalogUI} from '@/data/catalog-ui';
import type {Locale} from '@/i18n/locales';
import ProductMedia from './ProductMedia.astro';
interface Props { product: CatalogProduct; locale: Locale; filterable?: boolean; quoteHref?: string; }
const {product,locale,filterable=false,quoteHref='#quote'}=Astro.props;
const ui=catalogUI(locale);
const detail=detailsFor(product.id);
const search=[...Object.values(product.name),...Object.values(product.summary),...product.materials,...product.materials.map(m=>materialLabel(m,locale)),...product.variants.flatMap(v=>Object.values(v)),...detail.variants.flatMap(v=>[...Object.values(v.name),...Object.values(v.description)])].join(' ');
---
<article class="catalog-card product-visual-card group flex min-w-0 flex-col overflow-hidden border border-borui-navy/10 bg-white hover:border-borui-brass" data-catalog-card={filterable || undefined} data-group={product.group} data-materials={JSON.stringify(product.materials)} data-search={filterable ? search : undefined}>
  <a href={productPath(product,locale)} class="flex min-w-0 flex-1 flex-col">
    <ProductMedia product={product} locale={locale} visualCaption />
    <div class="flex flex-1 flex-col p-4 md:p-5">
      <h3 class="text-base leading-snug md:text-xl">{catalogText(product.name,locale)}</h3>
      <p class="mt-2 text-xs leading-relaxed text-slate-600">{product.materials.map(m=>materialLabel(m,locale)).join(' · ')}</p>
      <p class="mt-3 hidden text-sm leading-relaxed text-slate-600 sm:line-clamp-3">{catalogText(product.summary,locale)}</p>
      <p class="mt-3 text-xs leading-relaxed text-slate-600">{detail.variants.slice(0,3).map(v=>catalogText(v.name,locale)).join(' · ')}{detail.variants.length>3?' …':''}</p>
      <span class="mt-auto pt-5 text-sm font-medium text-borui-navy">{ui.details} <span class="text-xs font-normal text-slate-500">· {detail.variants.length} {locale==='zh'?'项配置':locale==='vi'?'cấu hình':'options'}</span> <span aria-hidden="true" class="ml-1 text-borui-brass">↗</span></span>
    </div>
  </a>
  <div class="border-t border-borui-navy/10 px-4 py-3 md:px-5">
    <a href={quoteHref} class="text-sm font-medium text-borui-navy underline underline-offset-4 hover:text-borui-brass">{ui.drawingCta} →</a>
  </div>
</article>
