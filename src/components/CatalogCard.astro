---
import {catalogText, materialLabel, productPath, type CatalogProduct} from '@/data/catalog';
import {catalogUI} from '@/data/catalog-ui';
import type {Locale} from '@/i18n/locales';
import ProductMedia from './ProductMedia.astro';
interface Props { product: CatalogProduct; locale: Locale; filterable?: boolean; }
const {product,locale,filterable=false}=Astro.props;
const ui=catalogUI(locale);
const search=[...Object.values(product.name),...Object.values(product.summary),...product.materials,...product.materials.map(m=>materialLabel(m,locale)),...product.variants.flatMap(v=>Object.values(v))].join(' ');
---
<a href={productPath(product,locale)} class="catalog-card group flex min-w-0 flex-col overflow-hidden border border-borui-navy/10 bg-white transition-colors hover:border-borui-brass" data-catalog-card={filterable || undefined} data-group={product.group} data-materials={JSON.stringify(product.materials)} data-search={filterable ? search : undefined}>
  <ProductMedia product={product} locale={locale} />
  <div class="flex flex-1 flex-col p-4 md:p-5">
    <h3 class="text-base leading-snug md:text-xl">{catalogText(product.name,locale)}</h3>
    <p class="mt-2 text-xs leading-relaxed text-slate-600">{product.materials.map(m=>materialLabel(m,locale)).join(' · ')}</p>
    <p class="mt-3 hidden text-sm leading-relaxed text-slate-600 sm:line-clamp-3">{catalogText(product.summary,locale)}</p>
    <span class="mt-auto pt-5 text-sm font-medium text-borui-navy">{ui.details} <span aria-hidden="true" class="ml-1 text-borui-brass">↗</span></span>
  </div>
</a>
