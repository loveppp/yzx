---
import { localeConfig, locales, type Locale } from '@/i18n/locales';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  type?: 'website' | 'article' | 'product';
}

const { title, description, locale, path, type = 'website' } = Astro.props;
const site = Astro.site?.href ?? 'https://yzxprecision.com';
const canonical = new URL(path, site).href;

const orgName =
  locale === 'zh'
    ? '深圳市源智信模具配件有限公司'
    : locale === 'vi'
      ? 'Công ty TNHH Linh kiện Khuôn Yuanzhixin Thâm Quyến'
      : 'YZX Precision';
const addressSchema =
  locale === 'zh'
    ? {
        '@type': 'PostalAddress',
        streetAddress: '龙岗街道新生社区低山龙山五路2号101',
        addressLocality: '深圳市',
        addressRegion: '广东省',
        postalCode: '518116',
        addressCountry: 'CN',
      }
    : {
        '@type': 'PostalAddress',
        streetAddress: 'Room 101, No. 2 Dishan Longshan 5th Road, Xinsheng, Longgang',
        addressLocality: 'Shenzhen',
        addressRegion: 'Guangdong',
        postalCode: '518116',
        addressCountry: 'CN',
      };
---

<meta charset="UTF-8" />
<link rel="icon" type="image/svg+xml" href="/images/brand/logo-icon.svg" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="geo.region" content="CN-GD" />
<meta name="geo.placename" content="Shenzhen, Guangdong, China" />
<meta name="geo.position" content="22.7215;114.2543" />
<meta name="ICBM" content="22.7215, 114.2543" />
{
  locales.map((code) => {
    const altPath = path.replace(`/${locale}/`, `/${code}/`);
    return (
      <link rel="alternate" hreflang={localeConfig[code].hreflang} href={new URL(altPath, site).href} />
    );
  })
}
<link rel="alternate" hreflang="x-default" href={new URL(path.replace(`/${locale}/`, '/en/'), site).href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={localeConfig[locale].hreflang.replace('-', '_')} />
<meta property="og:image" content={new URL('/images/factory/hero.png', site).href} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
  rel="stylesheet"
/>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: orgName,
  url: site,
  description,
  logo: new URL('/images/brand/logo.svg', site).href,
  address: addressSchema,
  areaServed: ['Worldwide', 'US', 'DE', 'JP', 'VN', 'CN'],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'inquiry@yzxprecision.com',
    contactType: 'sales',
    availableLanguage: ['English', 'Chinese', 'Vietnamese'],
  },
})} />
