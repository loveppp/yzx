---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'auto' | 'sync';
  width?: number;
  height?: number;
  watermark?: boolean;
  objectFit?: 'cover' | 'contain';
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  decoding,
  width,
  height,
  watermark = true,
  objectFit = 'cover',
} = Astro.props;
---

<div class:list={['branded-image relative overflow-hidden', className]}>
  <img
    src={src}
    alt={alt}
    class:list={['h-full w-full', objectFit === 'contain' ? 'object-contain bg-borui-light' : 'object-cover']}
    loading={loading}
    decoding={decoding}
    width={width}
    height={height}
  />
  {
    watermark && (
      <img
        src="/images/brand/logo-watermark.svg"
        alt=""
        class="pointer-events-none absolute bottom-[2.5%] right-[2.5%] h-auto w-[22%] max-w-[10.5rem] min-w-[4.5rem] opacity-[0.65]"
        aria-hidden="true"
      />
    )
  }
</div>
