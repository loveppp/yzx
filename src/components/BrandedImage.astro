---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'auto' | 'sync';
  width?: number;
  height?: number;
  watermark?: boolean;
  objectFit?: 'cover' | 'contain';
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  decoding,
  width,
  height,
  watermark = true,
  objectFit = 'cover',
} = Astro.props;
---

<div class:list={['branded-image relative overflow-hidden', className]}>
  <img
    src={src}
    alt={alt}
    class:list={['h-full w-full', objectFit === 'contain' ? 'object-contain bg-white' : 'object-cover bg-white']}
    loading={loading}
    decoding={decoding}
    width={width}
    height={height}
  />
  {
    watermark && (
      <img
        src="/images/brand/logo-watermark.svg"
        alt=""
        class="branded-image__wm pointer-events-none absolute bottom-[2.5%] right-[2.5%] h-auto min-w-0 opacity-[0.68]"
        aria-hidden="true"
      />
    )
  }
</div>

<style>
  /* Smaller on narrow viewports; % is of frame, capped so detail pages stay subtle */
  .branded-image__wm {
    width: 18%;
    max-width: 4.25rem;
  }
  @media (min-width: 640px) {
    .branded-image__wm {
      width: 20%;
      max-width: 5.25rem;
    }
  }
  @media (min-width: 768px) {
    .branded-image__wm {
      width: 22%;
      max-width: 6.5rem;
    }
  }
</style>
