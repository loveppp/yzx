---
import { catalogText, type CatalogProduct } from '@/data/catalog';
import { catalogUI } from '@/data/catalog-ui';
import type { Locale } from '@/i18n/locales';
interface Props { product: CatalogProduct; locale: Locale; caption?: boolean; eager?: boolean; }
const {product, locale, caption = false, eager = false} = Astro.props;
const ui = catalogUI(locale);
---
<figure class="min-w-0">
  <div class="aspect-[4/3] overflow-hidden bg-borui-light">
    <img src={product.image || product.illustration} alt={catalogText(product.name,locale)} width="800" height="600" loading={eager ? 'eager' : 'lazy'} class="h-full w-full object-contain" />
  </div>
  {caption && <figcaption class="px-1 py-3 text-xs leading-relaxed text-slate-600">{product.image ? ui.photo : ui.illustration}</figcaption>}
</figure>
