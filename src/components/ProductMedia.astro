---
import { catalogText, type CatalogProduct } from '@/data/catalog';
import { catalogUI } from '@/data/catalog-ui';
import {catalogVisuals} from '@/data/catalog-visuals';
import { shouldShowDisplayWatermark } from '@/data/product-image';
import type { Locale } from '@/i18n/locales';
import BrandedImage from './BrandedImage.astro';
interface Props {
  product: CatalogProduct;
  locale: Locale;
  caption?: boolean;
  eager?: boolean;
  visualCaption?: boolean;
  /** 默认 1:1。仅首页「产品分类」六大类封面（ProductStrip / group coverImage）用 4/3。 */
  frame?: '4/3' | '1/1';
  /** contain 保全貌（列表/详情）；cover 铺满方格（工厂页等小缩略图，可轻微裁切） */
  objectFit?: 'contain' | 'cover';
  /** 详情页传 detail；列表与详情均优先 detailImage（顶出 1:1 与冲针列表一致） */
  imageRole?: 'listing' | 'detail';
}
const {product, locale, caption = false, eager = false, visualCaption = false, frame = '1/1', objectFit = 'contain', imageRole = 'listing'} = Astro.props;
const ui = catalogUI(locale);
const square = frame === '1/1';
const src = product.image ?? product.illustration;
const showVisualCaption =
  visualCaption &&
  catalogVisuals[product.id] &&
  !/HTX/i.test(catalogText(catalogVisuals[product.id], locale));
---
<figure class="min-w-0">
  <div class:list={['product-visual-frame overflow-hidden bg-white', square ? 'aspect-square' : 'aspect-[4/3]']}>
    <BrandedImage
      src={src}
      alt={catalogText(product.name, locale)}
      width={800}
      height={square ? 800 : 600}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full"
      objectFit={objectFit}
      watermark={shouldShowDisplayWatermark(src)}
    />
  </div>
  {(caption||showVisualCaption)&&<figcaption class="px-4 py-3 text-xs leading-relaxed text-slate-600">
    {showVisualCaption&&<span class="block">{locale==='zh'?'图中：':locale==='vi'?'Trong hình: ':'Shown: '}{catalogText(catalogVisuals[product.id],locale)}</span>}
    {caption&&<span class="mt-1 block">{product.image ? ui.photo : ui.illustration}</span>}
  </figcaption>}
</figure>
