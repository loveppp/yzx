---
import QuoteForm from './QuoteForm';
import { categorySlugs, type Dictionary, type Locale } from '@/i18n/utils';

interface Props {
  t: Dictionary;
  locale: Locale;
}

const { t, locale } = Astro.props;

const categories = categorySlugs.map((slug) => ({
  value: slug,
  label: t.products.categories[slug],
}));
---

<section class="section-padding border-t border-borui-navy/10" id="quote">
  <div class="content-wrap grid gap-10 lg:grid-cols-2">
    <div>
      <h2 class="text-2xl text-borui-navy md:text-3xl">{t.quote.title}</h2>
      <p class="mt-3 text-borui-steel">{t.quote.subtitle}</p>
    </div>
    <QuoteForm client:visible labels={t.quote} categories={categories} />
  </div>
</section>
