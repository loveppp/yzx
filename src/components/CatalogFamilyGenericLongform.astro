---
import {catalogText, materialLabel, productById, productPath, type CatalogProduct} from '@/data/catalog';
import {detailUI as ui, type CatalogFamilyDetail} from '@/data/catalog-details';
import {familyExtrasFor, familyHasSplitApplications} from '@/data/catalog-family-extras';
import {familyFiguresFor} from '@/data/catalog-family-figures';
import {materialGuidanceFor, scenarioFor, questionFor, finishesFor, reasonFor} from '@/data/catalog-engineering';
import type {Locale} from '@/i18n/locales';
import ProductMedia from './ProductMedia.astro';

interface Props {
  product: CatalogProduct;
  locale: Locale;
  detail: CatalogFamilyDetail;
}

const {product, locale, detail} = Astro.props;
const extras = familyExtrasFor(product.id);
const figs = familyFiguresFor(product.id);
const splitApps =
  familyHasSplitApplications(product.id) ||
  Boolean(figs?.figures.applicationArea && figs?.figures.applicationScenario);
const tx = (value: Parameters<typeof catalogText>[0]) => catalogText(value, locale);
const labels = {
  zh: {materials: '可选材料及取舍', application: '典型场景', boundary: '选型重点', faqQ: '询价时需要提供哪些尺寸与工况？'},
  en: {materials: 'Available materials and trade-offs', application: 'Typical scenario', boundary: 'Selection considerations', faqQ: 'Which dimensions and operating details are needed for a quote?'},
  vi: {materials: 'Vật liệu và cân nhắc', application: 'Điều kiện điển hình', boundary: 'Lưu ý lựa chọn', faqQ: 'Cần kích thước và điều kiện nào để báo giá?'},
}[locale];

const faqItems: Array<[string, string]> = [
  [tx(questionFor(product.id)), tx(detail.note)],
  [labels.faqQ, tx(product.selection)],
];
if (extras?.extraFaqs) {
  for (const item of extras.extraFaqs) faqItems.push([tx(item.q), tx(item.a)]);
}
---

<section id="why-this-family" class="family-detail-section scroll-mt-28 bg-borui-navy p-6 text-white md:p-9" data-family-section="why">
  <h2 class="text-2xl md:text-3xl">{tx(ui.choice)}</h2>
  <div class="mt-5 grid gap-6 md:grid-cols-2">
    <p class="text-lg leading-relaxed text-slate-100">{tx(reasonFor(product.id))}</p>
    <div class="border-l-2 border-borui-brass pl-5">
      <h3 class="text-sm font-medium text-borui-brass">{labels.boundary}</h3>
      <p class="mt-3 text-sm leading-relaxed text-slate-200">{tx(detail.note)}</p>
    </div>
  </div>
</section>

<section id="material-options" class="family-detail-section scroll-mt-28" data-family-section="materials">
  <h2 class="text-2xl md:text-3xl">{tx(ui.material)}</h2>
  <h3 class="mt-6 text-sm font-medium text-slate-500">{labels.materials}</h3>
  <div class="mt-3 grid gap-3 md:grid-cols-2">
    {
      product.materials.map((material) => (
        <article class="border-l-2 border-borui-brass bg-white p-5">
          <h4 class="font-sans text-base font-semibold">{materialLabel(material, locale)}</h4>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{tx(materialGuidanceFor(product, material))}</p>
        </article>
      ))
    }
  </div>
</section>

<section id="surface-options" class="family-detail-section scroll-mt-28" data-family-section="surface">
  <h2 class="text-2xl md:text-3xl">{tx(ui.surface)}</h2>
  <div class="mt-5 grid gap-5 md:grid-cols-2">
    {
      finishesFor(product).map((finish) => (
        <article class="border-t border-borui-navy/20 pt-4">
          <h3 class="font-sans text-base font-semibold">{tx(finish.name)}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{tx(finish.description)}</p>
        </article>
      ))
    }
  </div>
</section>

{
  splitApps && extras ? (
    <>
      <section id="application-areas" class="family-detail-section scroll-mt-28" data-family-section="application-areas">
        <h2 class="text-2xl md:text-3xl">{tx(ui.applicationArea)}</h2>
        <p class="mt-5 max-w-3xl text-sm leading-relaxed text-slate-600">{tx(extras.applicationArea!)}</p>
      </section>
      <section id="application-scenarios" class="family-detail-section scroll-mt-28" data-family-section="application-scenarios">
        <h2 class="text-2xl md:text-3xl">{tx(ui.applicationScenario)}</h2>
        <p class="mt-5 max-w-3xl text-sm leading-relaxed text-slate-600">{tx(extras.applicationScenario!)}</p>
      </section>
    </>
  ) : (
    <section id="applications" class="family-detail-section scroll-mt-28" data-family-section="applications">
      <h2 class="text-2xl md:text-3xl">{tx(ui.application)}</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-[1fr_1.5fr]">
        <p class="text-sm leading-relaxed text-slate-600">{tx(product.application)}</p>
        <div class="border-l-2 border-borui-brass pl-5">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">{labels.application}</h3>
          <p class="mt-3 leading-relaxed">{tx(scenarioFor(product.id))}</p>
        </div>
      </div>
    </section>
  )
}

{
  extras?.relatedMaterials && extras.relatedMaterials.length > 0 && (
    <section id="related-stamping-materials" class="family-detail-section scroll-mt-28" data-family-section="related-materials">
      <h2 class="text-2xl md:text-3xl">{tx(ui.relatedMaterials)}</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {
          extras.relatedMaterials.map((item) => {
            const related = productById(item.productId);
            if (!related) return null;
            return (
              <article class="flex flex-col overflow-hidden border border-borui-navy/10 bg-white">
                <a href={productPath(related, locale)}>
                  <ProductMedia product={related} locale={locale} />
                </a>
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="text-lg font-medium">
                    <a href={productPath(related, locale)} class="hover:text-borui-brass">{catalogText(related.name, locale)} ↗</a>
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">{tx(item.blurb)}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  )
}

<section id="family-faq" class="family-detail-section scroll-mt-28" data-family-section="faq">
  <h2 class="text-2xl md:text-3xl">{tx(ui.faq)}</h2>
  <div class="mt-5 divide-y divide-borui-navy/10 border-y border-borui-navy/10">
    {
      faqItems.map(([q, a]) => (
        <details class="py-4">
          <summary class="cursor-pointer py-1 pr-4 text-sm font-medium leading-relaxed">{q}</summary>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">{a}</p>
        </details>
      ))
    }
  </div>
</section>

<style is:global>
  .family-detail-section {
    margin-top: 3rem;
    padding-top: 2.25rem;
    border-top: 1px solid rgb(15 23 42 / 0.1);
  }
  #why-this-family.family-detail-section {
    margin-top: 2.5rem;
    padding-top: 0;
    border-top: none;
  }
</style>
