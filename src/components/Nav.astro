---
import LangSwitch from './LangSwitch.astro';
import { productMegaMenuColumns, megaMenuLinkHref } from '@/data/nav-product-mega-menu';
import { localizedPath, type Dictionary, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
  t: Dictionary;
  currentPath: string;
}

const { locale, t, currentPath } = Astro.props;

const productsHref = localizedPath('/products/', locale);
const mega = t.nav.productMega;

const otherLinks = [
  { href: localizedPath('/custom-oem/', locale), label: t.nav.customOem },
  { href: localizedPath('/factory/', locale), label: t.nav.factory },
  { href: localizedPath('/blog/', locale), label: t.nav.blog },
  { href: localizedPath('/contact/', locale), label: t.nav.contact },
];
---

<header
  class="site-header sticky top-0 z-50 overflow-visible border-b border-borui-navy/10 bg-borui-paper/95 backdrop-blur-sm"
  data-products-mega
>
  <div class="relative overflow-visible">
    <div class="content-wrap flex items-center justify-between px-5 py-4 md:px-8">
      <a href={localizedPath('/', locale)} class="group flex items-center gap-3">
        <img src="/images/brand/logo-icon.svg" alt="" class="h-9 w-9 shrink-0" width="36" height="36" />
        <span class="hidden min-w-0 sm:block">
          <span class="block truncate font-serif text-lg font-semibold leading-tight text-borui-navy md:text-xl">
            {t.siteName}
          </span>
          <span class="block truncate text-xs text-borui-steel">{t.siteNameFull}</span>
        </span>
      </a>

      <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
        <a
          href={productsHref}
          class="products-trigger text-sm text-borui-navy/80 transition-colors hover:text-borui-navy"
          aria-haspopup="true"
          aria-expanded="false"
        >
          {t.nav.products}
        </a>
        {
          otherLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-borui-navy/80 transition-colors hover:text-borui-navy"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-4">
        <LangSwitch locale={locale} currentPath={currentPath} />
        <a href={localizedPath('/contact/', locale)} class="btn-primary hidden text-xs sm:inline-block">
          {t.hero.ctaQuote}
        </a>
      </div>
    </div>

    <nav class="flex gap-4 overflow-x-auto border-t border-borui-navy/5 px-5 py-2 lg:hidden" aria-label="Mobile">
      <a href={productsHref} class="whitespace-nowrap text-xs text-borui-navy/70">
        {t.nav.products}
      </a>
      {
        otherLinks.map((link) => (
          <a href={link.href} class="whitespace-nowrap text-xs text-borui-navy/70">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div
      class="products-mega-panel pointer-events-none absolute inset-x-0 top-full z-[60] hidden -translate-y-6 pt-8 opacity-0 transition-opacity duration-100 lg:block"
      role="region"
      aria-label={t.nav.products}
    >
      <div class="border-t border-borui-navy/10 bg-white shadow-lg">
        <div class="content-wrap px-5 py-6 md:px-8">
          <div class="grid grid-cols-7 divide-x divide-borui-navy/10">
            {
              productMegaMenuColumns.map((col) => (
                <div class="min-w-0 px-3 first:pl-0 last:pr-0">
                  <p class="text-sm font-bold text-borui-navy">
                    {mega.columns[col.titleKey as keyof typeof mega.columns]}
                  </p>
                  <ul class="mt-3 space-y-0.5">
                    {col.links.map((link) => {
                      const href = megaMenuLinkHref(locale, link, localizedPath);
                      const label = mega.links[link.labelKey as keyof typeof mega.links];
                      return (
                        <li>
                          <a
                            href={href}
                            class="block rounded-sm px-2 py-1.5 text-sm text-borui-steel transition-colors hover:bg-borui-navy hover:text-white"
                          >
                            {label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))
            }
          </div>
          <a
            href={productsHref}
            class="mt-5 inline-block text-xs font-medium text-borui-brass hover:text-borui-navy"
          >
            {t.nav.viewAllProducts} →
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  @media (min-width: 1024px) {
    .site-header.products-mega-open .products-mega-panel,
    .site-header:has(.products-mega-panel:focus-within) .products-mega-panel {
      opacity: 1;
      pointer-events: auto;
    }

    /* 向下延伸 hover 区，不占布局高度，避免「产品中心」与其它 nav 错位 */
    .products-trigger {
      position: relative;
      z-index: 61;
    }
    .products-trigger::after {
      content: '';
      position: absolute;
      left: -0.5rem;
      right: -0.5rem;
      top: 100%;
      height: 2rem;
    }
  }
</style>

<script>
  function initProductsMegaMenu() {
    const header = document.querySelector<HTMLElement>('[data-products-mega]');
    const trigger = document.querySelector<HTMLElement>('.products-trigger');
    const panel = document.querySelector<HTMLElement>('.products-mega-panel');
    if (!header || !trigger || !panel) return;

    const mq = window.matchMedia('(min-width: 1024px)');
    let closeTimer: number | undefined;

    const open = () => {
      if (!mq.matches) return;
      window.clearTimeout(closeTimer);
      header.classList.add('products-mega-open');
      trigger.setAttribute('aria-expanded', 'true');
    };

    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        header.classList.remove('products-mega-open');
        trigger.setAttribute('aria-expanded', 'false');
      }, 280);
    };

    const bind = () => {
      trigger.addEventListener('mouseenter', open);
      panel.addEventListener('mouseenter', open);
      trigger.addEventListener('mouseleave', scheduleClose);
      panel.addEventListener('mouseleave', scheduleClose);
      trigger.addEventListener('focus', open);
    };

    bind();

    mq.addEventListener('change', () => {
      if (!mq.matches) {
        header.classList.remove('products-mega-open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initProductsMegaMenu();
  document.addEventListener('astro:page-load', initProductsMegaMenu);
</script>
