---
import LangSwitch from './LangSwitch.astro';
import {catalogGroups,groupProducts,groupPath,productPath,catalogText} from '@/data/catalog';
import {catalogUI} from '@/data/catalog-ui';
import {localizedPath,type Dictionary,type Locale} from '@/i18n/utils';
interface Props {locale:Locale;t:Dictionary;currentPath:string;}
const {locale,t,currentPath}=Astro.props;
const ui=catalogUI(locale);
const otherLinks=[{href:localizedPath('/custom-oem/',locale),label:t.nav.customOem},{href:localizedPath('/factory/',locale),label:t.nav.factory},{href:localizedPath('/blog/',locale),label:t.nav.blog},{href:localizedPath('/contact/',locale),label:t.nav.contact}];
---
<header class="site-header sticky top-0 z-50 border-b border-borui-navy/10 bg-borui-paper" data-site-header>
  <div class="content-wrap flex min-h-[76px] items-center justify-between gap-3 px-5 py-3 md:px-8">
    <a href={localizedPath('/',locale)} class="flex min-w-0 items-center gap-2.5" aria-label={t.siteName}>
      <img src="/images/brand/logo-icon.svg" alt="" width="34" height="34" class="h-[34px] w-[34px] shrink-0" />
      <span data-brand-name class="font-serif text-base font-semibold whitespace-nowrap xl:text-xl">{t.siteName}</span>
    </a>
    <nav class="hidden items-center gap-5 lg:flex" aria-label={ui.menu}>
      <details class="desktop-products" data-nav-panel>
        <summary class="cursor-pointer list-none py-3 text-sm font-medium">{t.nav.products} <span aria-hidden="true" class="ml-1">⌄</span></summary>
        <div data-desktop-products-panel class="absolute inset-x-0 top-full max-h-[calc(100dvh-90px)] overflow-y-auto border-y border-borui-navy/10 bg-white">
          <div class="content-wrap px-8 py-7">
            <div class="mb-6 flex items-center justify-between gap-4 border-b border-borui-navy/10 pb-4">
              <a class="text-lg font-semibold" href={localizedPath('/products/',locale)}>{ui.allProducts} →</a>
              <button type="button" data-close-menu class="min-h-11 px-3 text-sm">{ui.close} ×</button>
            </div>
            <div class="grid grid-cols-4 gap-x-8 gap-y-7">
              {catalogGroups.map(g=><div>
                <a class="font-semibold" href={groupPath(g,locale)}>{catalogText(g.name,locale)} →</a>
                <ul class="mt-3 space-y-1">{groupProducts(g.id).map(p=><li><a class="block py-1 text-sm leading-relaxed text-slate-600 hover:text-borui-navy hover:underline" href={productPath(p,locale)}>{catalogText(p.name,locale)}</a></li>)}</ul>
              </div>)}
            </div>
          </div>
        </div>
      </details>
      {otherLinks.map(l=><a href={l.href} class="py-3 text-sm text-slate-700 hover:underline" aria-current={currentPath===l.href?'page':undefined}>{l.label}</a>)}
    </nav>
    <div class="flex shrink-0 items-center gap-2 xl:gap-4">
      <LangSwitch locale={locale} currentPath={currentPath} />
      <a class="btn-primary hidden !px-4 !text-xs xl:inline-block" href={localizedPath('/contact/',locale)}>{ui.quote}</a>
      <details class="mobile-menu lg:hidden" data-nav-panel>
        <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center border border-borui-navy/20 px-2 text-sm" aria-label={ui.menu}><span aria-hidden="true">☰</span><span class="sr-only">{ui.menu}</span></summary>
        <nav class="absolute inset-x-0 top-full max-h-[calc(100dvh-140px)] overflow-y-auto overscroll-contain border-b border-borui-navy/20 bg-white p-5" aria-label={ui.menu}>
          <div class="flex items-center justify-between gap-3 border-b border-borui-navy/10 pb-3"><a href={localizedPath('/products/',locale)} class="py-3 font-semibold">{ui.allProducts} →</a><button type="button" class="min-h-11 px-3 text-sm" data-close-menu>{ui.close} ×</button></div>
          {catalogGroups.map(g=><details class="border-b border-borui-navy/10">
            <summary class="cursor-pointer py-4 text-sm font-medium">{catalogText(g.name,locale)}</summary>
            <ul class="pb-3 pl-3 text-sm">
              <li><a class="block py-3 font-medium" href={groupPath(g,locale)}>{ui.browse} →</a></li>
              {groupProducts(g.id).map(p=><li><a class="block py-3 text-slate-600" href={productPath(p,locale)}>{catalogText(p.name,locale)}</a></li>)}
            </ul>
          </details>)}
          <div class="grid grid-cols-2 gap-2 pt-4">{otherLinks.map(l=><a class="py-3 text-sm" href={l.href}>{l.label}</a>)}</div>
          <a class="btn-primary mt-4 block text-center" href={localizedPath('/contact/',locale)}>{ui.drawingCta}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>summary::-webkit-details-marker{display:none} details[open]>summary{color:#755719} .mobile-menu details>summary{list-style:disclosure-closed} .mobile-menu details[open]>summary{list-style:disclosure-open}</style>
<script>
  const panels = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-panel]')];
  const desktopProducts = document.querySelector<HTMLDetailsElement>('.desktop-products');
  const desktopPanel = document.querySelector<HTMLElement>('[data-desktop-products-panel]');
  const hoverMedia = matchMedia('(min-width:1024px) and (hover:hover) and (pointer:fine)');
  let hoverCloseTimer: number | undefined;
  const cancelHoverClose = () => window.clearTimeout(hoverCloseTimer);

  if (desktopProducts && desktopPanel) {
    const openOnHover = (event: PointerEvent) => {
      if (!hoverMedia.matches || event.pointerType !== 'mouse') return;
      cancelHoverClose();
      desktopProducts.open = true;
    };
    const closeAfterHover = (event: PointerEvent) => {
      if (!hoverMedia.matches || event.pointerType !== 'mouse') return;
      cancelHoverClose();
      // Allow the pointer to cross the small gap below the navigation bar.
      hoverCloseTimer = window.setTimeout(() => {
        if (!desktopPanel.contains(document.activeElement)) desktopProducts.open = false;
      }, 220);
    };
    for (const surface of [desktopProducts, desktopPanel]) {
      surface.addEventListener('pointerenter', openOnHover);
      surface.addEventListener('pointerleave', closeAfterHover);
    }
  }

  function closePanels(restore=false) { cancelHoverClose(); panels.forEach(p=>{if(p.open){p.open=false;if(restore)p.querySelector('summary')?.focus();}}); }
  panels.forEach(p=>{
    p.querySelector('[data-close-menu]')?.addEventListener('click',()=>{cancelHoverClose();p.open=false;p.querySelector('summary')?.focus();});
    p.addEventListener('toggle',()=>{if(p.open)panels.filter(other=>other!==p).forEach(other=>other.open=false);});
  });
  document.addEventListener('click',e=>{if(!panels.some(p=>p.contains(e.target as Node)))closePanels();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closePanels(true);});
  document.addEventListener('focusin',e=>{if(!panels.some(p=>p.contains(e.target as Node)))closePanels();});
  matchMedia('(min-width:1024px)').addEventListener('change',()=>closePanels());
  hoverMedia.addEventListener('change',()=>closePanels());
</script>
