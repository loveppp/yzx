{
  "name": "borui-mold-components",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=18.20.8"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:astro": "astro dev",
    "build": "bash -lc 'source scripts/use-node20.sh && node scripts/prepare-catalog.mjs && node scripts/check-catalog.mjs && astro check && astro build'",
    "preview": "bash -lc 'source scripts/use-node20.sh && astro preview'",
    "astro": "astro",
    "image-gen": "bash scripts/image-gen/run.sh",
    "image-gen:help": "npm run image-gen -- 帮助",
    "catalog:check": "bash -lc 'source scripts/use-node20.sh && node scripts/check-catalog.mjs'",
    "images:watermark": "bash -lc 'source scripts/use-node20.sh && node scripts/watermark-images.mjs'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "sharp": "^0.34.4",
    "tsx": "^4.19.3"
  }
}
