# Terrakinc image API — copy to .env and fill in (never commit .env)
# https://api.terrakinc.com/docs/image-api-reference.html

TERRAKINC_API_TOKEN=sk-your-token-here

# Optional (defaults shown)
TERRAKINC_BASE_URL=https://api.terrakinc.com
TERRAKINC_IMAGE_MODEL=gemini-3.0-pro-image

# Factory page — YouTube watch or youtu.be link (optional; section hidden if empty)
# PUBLIC_FACTORY_YOUTUBE_URL=https://www.youtube.com/watch?v=xxxxxxxxxxx
